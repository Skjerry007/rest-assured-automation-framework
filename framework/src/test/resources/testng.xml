<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Rest Assured API Test Suite" parallel="tests" thread-count="3">
    <parameter name="environment" value="dev"/>
    
    <!-- API Tests -->
    <test name="API Tests">
        <classes>
            <!-- Album API Tests -->
            <class name="com.automation.api.tests.AlbumApiTest"/>
            
            <!-- API Exception Tests -->
            <class name="com.automation.api.tests.APIExceptionHandlingTest"/>
            
            <!-- Photo API Tests -->
            <class name="com.automation.api.tests.PhotoApiTest"/>
            
            <!-- Post API Tests -->
            <class name="com.automation.api.tests.PostApiTest"/>
            
            <!-- Todo API Tests -->
            <class name="com.automation.api.tests.TodoApiTest"/>
            
            <!-- User API Tests -->
            <class name="com.automation.api.tests.UserApiTest"/>
        </classes>
    </test>
    
    <!-- Listeners -->
    <listeners>
        <listener class-name="com.automation.common.listeners.TestListener"/>
        <listener class-name="com.automation.common.listeners.AnnotationTransformer"/>
    </listeners>
</suite>